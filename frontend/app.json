{
  "expo": {
    "name": "CinePlay",
    "slug": "cineplay",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3bfb20e0-6dd2-4c96-9f25-40a7430c15c7"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cineplay",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0A0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ankitpandey.cineplay",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow CinePlay to securely transcribe your voice into text for search.",
        "NSMicrophoneUsageDescription": "Allow CinePlay to access your microphone to search for movies and shows."
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.ankitpandey.cineplay",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#170D22"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1014",
          "image": "./assets/splash.png"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow CinePlay to access your microphone to search for movies and shows.",
          "speechRecognitionPermission": "Allow CinePlay to securely transcribe your voice into text for search.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00E5FF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bfb20e0-6dd2-4c96-9f25-40a7430c15c7"
      }
    }
  }
}